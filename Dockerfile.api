# =============================================================
# Pitica Study - API (Fastify + Prisma)
# Roda o TypeScript direto com tsx: sem etapa "tsc", sem erro de build.
# Base Debian (glibc) porque onnxruntime (@xenova/transformers),
# Prisma e ffmpeg-static não funcionam bem em Alpine (musl).
# =============================================================
FROM node:20-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1) Só os manifests primeiro (melhor cache de camadas)
COPY package.json package-lock.json* ./
COPY apps/api/package.json ./apps/api/package.json

# 2) Instala deps da API + raiz (inclui devDeps: tsx e prisma CLI são necessários em runtime)
RUN npm install --workspace=apps/api --include-workspace-root --no-audit --no-fund

# 3) Código da API
COPY apps/api ./apps/api

WORKDIR /app/apps/api

# 4) Gera o Prisma Client para esta plataforma
RUN npx prisma generate

RUN mkdir -p uploads/classes uploads/tasks

ENV NODE_ENV=production \
    PORT=3000

EXPOSE 3000

# Aplica migrations pendentes e sobe o servidor
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx src/server.ts"]
