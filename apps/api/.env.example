PORT=3000
DATABASE_URL="postgresql://pitica:piticapassword@localhost:5433/pitica_study?schema=public"

# Google Gemini (obrigatória) - https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opcionais
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_MS=90000

# Autenticação
# JWT_SECRET é obrigatória (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=""
# Opcionais
JWT_EXPIRES_IN="7d"
# Cadastro público (padrão false). Crie contas com: npm run user:create -- <email> <senha> [nome]
ALLOW_REGISTRATION=false
